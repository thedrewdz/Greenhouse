@page "/"
@using Greenhouse.Core.Configuration
@using Greenhouse.Core.Onboarding
@using Greenhouse.Core.Onboarding.Abstractions
@using Greenhouse.Core.Setup
@using Greenhouse.Core.Setup.Abstractions
@implements IDisposable
@inject SetupApplicationService SetupService
@inject IMainConfigRepository MainConfigRepository
@inject INetworkService NetworkService
@inject IEdgeUnitDiscoveryService EdgeUnitDiscoveryService
@inject NavigationManager Navigation

<PageTitle>Home</PageTitle>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (config is not null)
{
    @if (!isNetworkConnected)
    {
        <div class="network-alert" role="alert">
            <div>
                <strong>Offline</strong>
                <span>Network features are unavailable.</span>
            </div>
            <a class="touch-button" href="network">Connect</a>
        </div>
    }

    <section class="dashboard-header">
        <div>
            <p class="eyebrow">Main Unit</p>
            <h1>@config.GreenhouseName</h1>
            <p>@config.GreenhouseLocation</p>
        </div>

        <div class="status-pill @(isNetworkConnected ? "status-ok" : "status-warning")">
            @(isNetworkConnected ? "Online" : "Offline")
        </div>
    </section>

    <section class="dashboard-grid">
        <div class="dashboard-tile">
            <div class="tile-heading">
                <span>Edge Units</span>
                <strong>0</strong>
            </div>
            <p>Connect an Edge Unit to unlock telemetry, control, and automation.</p>

            <div class="tile-actions">
                <button class="icon-button" type="button" @onclick="ScanForEdgeUnitsAsync" disabled="@isScanningForEdgeUnits" aria-label="Add Edge Unit" title="Add Edge Unit">
                    +
                </button>
            </div>

            @if (isScanningForEdgeUnits)
            {
                <div class="scan-status" role="status">Scanning for GH-Edge devices...</div>
            }
            else if (!string.IsNullOrWhiteSpace(edgeUnitScanError))
            {
                <div class="scan-status scan-error" role="alert">@edgeUnitScanError</div>
            }
            else if (hasScannedForEdgeUnits && discoveredEdgeUnits.Count == 0)
            {
                <div class="scan-status">No Edge Units found.</div>
            }
            else if (discoveredEdgeUnits.Count > 0)
            {
                <ul class="edge-unit-list" aria-label="Discovered Edge Units">
                    @foreach (var edgeUnit in discoveredEdgeUnits)
                    {
                        <li>
                            <strong>@edgeUnit.Name</strong>
                            <span>@edgeUnit.Address</span>
                            @if (edgeUnit.Rssi is not null)
                            {
                                <span>@edgeUnit.Rssi dBm</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="dashboard-tile">
            <div class="tile-heading">
                <span>Automation Rules</span>
                <strong>0</strong>
            </div>
            <p>Rules can be created after Edge Units are connected.</p>
        </div>
    </section>
}

@code {
    private bool isLoading = true;
    private MainConfig? config;
    private bool isNetworkConnected;
    private bool isScanningForEdgeUnits;
    private bool hasScannedForEdgeUnits;
    private string? edgeUnitScanError;
    private IReadOnlyList<DiscoveredEdgeUnit> discoveredEdgeUnits = Array.Empty<DiscoveredEdgeUnit>();
    private CancellationTokenSource? edgeUnitScanCancellation;

    protected override async Task OnInitializedAsync()
    {
        var status = await SetupService.GetStatusAsync();
        if (!status.IsSetupComplete)
        {
            Navigation.NavigateTo("/setup", replace: true);
            return;
        }

        config = await MainConfigRepository.GetAsync();
        isNetworkConnected = await NetworkService.IsConnectedAsync();
        isLoading = false;
    }

    private async Task ScanForEdgeUnitsAsync()
    {
        if (isScanningForEdgeUnits)
        {
            return;
        }

        edgeUnitScanCancellation?.Dispose();
        edgeUnitScanCancellation = new CancellationTokenSource();
        isScanningForEdgeUnits = true;
        hasScannedForEdgeUnits = true;
        edgeUnitScanError = null;
        discoveredEdgeUnits = Array.Empty<DiscoveredEdgeUnit>();

        try
        {
            var result = await EdgeUnitDiscoveryService.ScanAsync(
                TimeSpan.FromSeconds(10),
                edgeUnitScanCancellation.Token);

            if (!result.Succeeded)
            {
                edgeUnitScanError = result.ErrorMessage ?? "Unable to scan for Edge Units.";
                return;
            }

            discoveredEdgeUnits = result.EdgeUnits;
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            isScanningForEdgeUnits = false;
        }
    }

    public void Dispose()
    {
        edgeUnitScanCancellation?.Cancel();
        edgeUnitScanCancellation?.Dispose();
    }
}
